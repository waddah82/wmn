 "fields": [
  {
   "fieldname": "pos_profile",
   "label": "POS Profile",
   "fieldtype": "Link",
   "options": "POS Profile",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldtype": "Section Break",
   "label": "POS Behavior",
   "fieldname": "section_1"
  },
  {
   "fieldname": "default_item_view",
   "label": "Default Item View",
   "fieldtype": "Select",
   "options": "Grid View\nButton View",
   "default": "Grid View"
  },
  {
   "fieldname": "show_item_cart_counter",
   "label": "Show Item Cart Quantity Counter",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "ignore_pricing_rule",
   "label": "Ignore Pricing Rule",
   "fieldtype": "Check",
   "default": "0",
   "description": "When enabled, WMN POS disables the WMN local Pricing Rule engine. ERPNext native Pricing Rule execution remains disabled in WMN POS, so no Pricing Rules are applied."
  },
  {
   "fieldname": "commercial_discount_composition_section",
   "fieldtype": "Section Break",
   "label": "Commercial Discount Composition"
  },
  {
   "default": "Combine",
   "fieldname": "pricing_rule_promotion_policy",
   "fieldtype": "Select",
   "label": "Pricing Rule + Promotion",
   "options": "Pricing Rule Wins\nPromotion Wins\nCombine"
  },
  {
   "default": "Combine",
   "fieldname": "pricing_rule_coupon_policy",
   "fieldtype": "Select",
   "label": "Pricing Rule + Coupon",
   "options": "Pricing Rule Wins\nCoupon Wins\nCombine"
  },
  {
   "default": "Combine",
   "fieldname": "promotion_coupon_policy",
   "fieldtype": "Select",
   "label": "Promotion + Coupon",
   "options": "Promotion Wins\nCoupon Wins\nCombine"
  },
  {
   "default": "Combine",
   "fieldname": "pricing_rule_promotion_coupon_policy",
   "fieldtype": "Select",
   "label": "Pricing Rule + Promotion + Coupon",
   "options": "Pricing Rule Wins\nPromotion Wins\nCoupon Wins\nCombine"
  },
  {
   "default": "Amount Only",
   "description": "Used only when the selected conflict policy is Combine. Percentage Equivalent converts the final combined amount to one invoice-level percentage on Net Total.",
   "fieldname": "combined_discount_representation",
   "fieldtype": "Select",
   "label": "Combined Discount Representation",
   "options": "Amount Only\nPercentage Equivalent (Net Total)"
  },
  {
   "fieldname": "payment_gateway_section",
   "fieldtype": "Section Break",
   "label": "Electronic Payment Gateways"
  },
  {
   "fieldname": "payment_gateways",
   "fieldtype": "Table",
   "label": "Payment Gateways",
   "options": "WMN POS Payment Gateway"
  },
  {
   "fieldtype": "Section Break",
   "label": "Printing",
   "fieldname": "section_2"
  },
  {
   "fieldname": "enable_auto_silent_print",
   "label": "Enable Auto Silent Print",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "print_after_cashier_completion",
   "label": "Print Again After Cashier Completion",
   "fieldtype": "Check",
   "default": "0",
   "description": "When enabled, a cashier handoff invoice is printed again after final completion. The handoff print remains unchanged."
  },
  {
   "fieldname": "printing_method",
   "label": "Printing Method",
   "fieldtype": "Select",
   "options": "legacy_bridge\nbrowser\nwebusb\nwebserial\nqz",
   "default": "legacy_bridge"
  },
  {
   "fieldname": "fallback_method",
   "label": "Fallback Printing Method",
   "fieldtype": "Select",
   "options": "none\nlegacy_bridge\nbrowser\nwebusb\nwebserial\nqz",
   "default": "none"
  },
  {
   "fieldname": "copies",
   "label": "Copies",
   "fieldtype": "Int",
   "default": "1"
  },
  {
   "fieldname": "cut_paper",
   "label": "Cut Paper",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "feed_lines",
   "label": "Feed Lines",
   "fieldtype": "Int",
   "default": "3"
  },
  {
   "fieldname": "escpos_initialize",
   "label": "Initialize ESC/POS Printer",
   "fieldtype": "Check",
   "default": "1"
  },
  {
